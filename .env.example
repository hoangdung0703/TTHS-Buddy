# Backend (backend/app/core/config.py, ingestion/config.py) - root .env, read by both the
# FastAPI app and the standalone ingestion/ scripts.
ENVIRONMENT=development
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret # kept for compatibility; current Supabase JWT verification uses JWKS (ES256)

# Google AI (Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional - stronger model used only for final generation on long/tình huống questions
# (is_long_question, see rag_service.py). Falls back to GEMINI_CHAT_MODEL if unset.
GEMINI_CHAT_MODEL_COMPLEX=gemini-3.1-pro-preview

# Qdrant
QDRANT_URL=your_qdrant_cloud_url
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=ttths_law_chunks

# CORS - comma-separated list of allowed origins, defaults to "http://localhost:3000" if unset.
# Add a LAN origin here when testing on a real phone over WiFi (frontend running with
# `next dev -H 0.0.0.0`, phone hitting your machine's LAN IP instead of localhost), e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.5:3000

# Frontend (frontend/.env.local, NOT the root .env - Next.js only reads NEXT_PUBLIC_* vars from
# its own package directory)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Toggle for lib/api.ts: "false" calls the real backend at NEXT_PUBLIC_API_BASE_URL (default -
# every clone of this repo should run against real data unless someone deliberately opts out).
# Only set to "true" if you are intentionally doing frontend-only UI work with no backend running
# and don't need real answers/data - e.g. iterating on layout/styling in isolation. Do NOT leave
# it "true" for any kind of review, demo, UAT, or "verify Phase X works" pass: an incident on
# 2026-07-31 found this flag stuck at "true" since Phase 8 (backend was ready, frontend still
# served lib/mockData.ts) undetected through multiple later "verified with real data" reports,
# because those verifications tested the backend/evaluation script directly and never exercised
# the frontend with mock mode off. See requirements.md build log for the full incident writeup.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Phase 9 evaluation (backend/evaluation/run_evaluation.py) - process env vars, NOT stored in
# .env (avoid committing real test-account credentials): export them in the shell before running
# the script. EVAL_API_BASE_URL defaults to http://localhost:8000 if unset. The account must
# already exist in Supabase Auth (sign up via the frontend /register page, or create it directly
# in the Supabase dashboard) - the script only signs in, it does not create the account.
# EVAL_API_BASE_URL=http://localhost:8000
# EVAL_USER_EMAIL=your_test_account_email
# EVAL_USER_PASSWORD=your_test_account_password
